# Copy this file to .env and fill in real values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# PostgreSQL connection string (required -- the project no longer uses SQLite).
# Neon gives you this on the project dashboard, e.g.
#   postgresql://user:password@ep-xxx-123.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Set to "disable" only for a local Postgres that has no SSL configured.
DB_SSLMODE=require

# Report scanning reads a photo of a medical report with Tesseract OCR and
# fills the prediction form from it. Tesseract is not a pip package -- install
# the engine separately from
#   https://github.com/UB-Mannheim/tesseract/wiki
# Set this only if tesseract.exe is not on PATH. Without it the rest of the
# application still works; only the scan button reports that it is off.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
